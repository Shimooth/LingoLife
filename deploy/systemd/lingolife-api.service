[Unit]
Description=LingoLife demo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lingolife
Group=lingolife
WorkingDirectory=/opt/lingolife/app/backend
EnvironmentFile=/etc/lingolife/lingolife.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lingolife/venv/bin/uvicorn lingolife.app:app --host 127.0.0.1 --port 8010 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Conservative isolation that is compatible with SQLite and outbound AI calls.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lingolife/data
RestrictSUIDSGID=true
LockPersonality=true

# A single worker is intentional on a 1 GB VPS.
MemoryHigh=350M
MemoryMax=450M
TasksMax=128

[Install]
WantedBy=multi-user.target
