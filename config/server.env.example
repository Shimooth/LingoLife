# Copy to .env for local development or to
# /etc/lingolife/lingolife.env on the VPS. Never commit the real file.
DEEPSEEK_API_KEY=replace-me
# Protects the admin UI. Use a unique high-entropy value; never reuse an account password.
ADMIN_PASSWORD=replace-with-a-long-random-secret
# Signs login sessions. Generate independently, for example with: openssl rand -hex 32
SESSION_SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_ALLOWED_ORIGIN=https://lingolife.admin.shimooth.me
ADMIN_COOKIE_SECURE=true
DEFAULT_DAILY_QUOTA=30
CHAT_PER_MINUTE=5
DATABASE_URL=sqlite:////opt/lingolife/data/lingolife.db
LINGOLIFE_CONFIG=/opt/lingolife/app/config/lingolife.example.yaml
LOG_LEVEL=INFO
